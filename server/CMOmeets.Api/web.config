<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom web.config for IIS hosting. `dotnet publish` keeps the <modules>/<handlers> below and
  refreshes the <aspNetCore> element (dll name, hosting model) automatically.

  WHY: IIS's WebDAV module registers ahead of the ASP.NET Core handler and intercepts PUT and DELETE
  requests, returning "405 Method Not Allowed" before they reach the API — while GET/POST pass through
  untouched. Removing the WebDAV module + handler for this app lets PUT/DELETE reach ASP.NET Core.
  Dev (Kestrel) never has WebDAV, which is why this only shows up in production under IIS.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <modules runAllManagedModulesForAllRequests="false">
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\CMOmeets.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
